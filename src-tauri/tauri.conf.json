{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tyba",
  "version": "0.6.3",
  "identifier": "dev.tyba.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tyba",
        "width": 1200,
        "height": 780,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "backgroundColor": "#050505"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Seu ambiente, tudo conectado.",
    "longDescription": "Terminal opensource orientado a agentes de IA: orquestra múltiplas sessões de agentes em git worktrees isolados, com inbox de aprovações, review de diff local e sandbox real do sistema operacional.",
    "licenseFile": "../LICENSE",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist",
      "dmg": {
        "background": "icons/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 360
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "bubblewrap"
        ]
      },
      "rpm": {
        "depends": [
          "bubblewrap"
        ]
      }
    }
  }
}
