pkgname=tyba-bin
_pkgname=tyba
pkgver=0.4.0
pkgrel=1
pkgdesc="Terminal orientado a agentes de IA — sessões em worktrees isolados, inbox de aprovações e sandbox real do SO"
arch=('x86_64')
url="https://github.com/tybadev/tyba-terminal"
license=('Apache-2.0')
# bubblewrap não é opcional: sem ele o core recusa spawnar agente (fail-closed)
# e o Tyba vira só um terminal.
depends=('bubblewrap' 'webkit2gtk-4.1' 'gtk3' 'git')
optdepends=('claude-code: runner de agente Claude Code'
            'codex: runner de agente Codex')
provides=('tyba')
conflicts=('tyba')
options=('!strip')
# O .deb (e não o tarball) é a fonte de propósito: ele carrega o .desktop e os
# ícones, que o tarball não tem. O pacote da AUR só reempacota o que a CI
# publicou — e o que a CI publicou tem attestation de procedência.
source=("${_pkgname}-${pkgver}.deb::${url}/releases/download/v${pkgver}/Tyba_${pkgver}_amd64.deb")
# NUNCA 'SKIP': num pacote -bin, o checksum é a ÚNICA coisa que amarra o que o
# usuário instala ao que nós publicamos. O placeholder é preenchido no release
# (skill `cut-release`) com o hash do artefato publicado — e falha alto se
# alguém esquecer, em vez de instalar sem verificar nada.
sha256sums=('bdc551119f797a1d38fd7319d793e67f012c7b78a6a7b511dcc7770c397efc15')

package() {
  bsdtar -xf "${srcdir}/${_pkgname}-${pkgver}.deb" -C "${srcdir}" data.tar.gz
  bsdtar -xf "${srcdir}/data.tar.gz" -C "${pkgdir}"
}
