            "pages": [
              "pt-br/git/worktrees",
              "pt-br/git/setup-script",
              "pt-br/git/branches",
              "pt-br/git/conflitos"
            ]
          },
          {
            "group": "Review e entrega",
            "pages": [
              "pt-br/review/ler-o-diff",
              "pt-br/review/commit-e-push",
              "pt-br/review/merge-local",
              "pt-br/review/pull-requests",
              "pt-br/review/comentarios-para-o-agente"
