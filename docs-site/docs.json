              "pt-br/terminal/busca",
              "pt-br/terminal/colar-com-seguranca",
              "pt-br/terminal/shell-integration"
            ]
          },
          {
            "group": "Interface",
            "pages": [
              "pt-br/interface/abas-e-workspaces",
              "pt-br/interface/split-de-paineis",
              "pt-br/interface/paleta-de-comandos",
              "pt-br/interface/atalhos"
            ]
          },
          {
            "group": "Temas",
            "pages": [
              "pt-br/temas/modo-e-slots",
              "pt-br/temas/os-temas",
              "pt-br/temas/importar-tema"
            ]
          },
          {
